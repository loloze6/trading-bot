{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regime Detector Report",
  "description": "Campaign-scoped standalone validation of the regime detector, independent of any hypothesis.",
  "type": "object",
  "required": ["detector_version", "evaluated_at", "data_range", "per_symbol_per_timeframe"],
  "additionalProperties": false,
  "properties": {
    "detector_version": {
      "type": "string",
      "description": "SHA8 of the detector config JSON, so staleness is detectable."
    },
    "evaluated_at": {"type": "string"},
    "data_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end":   {"type": "string"}
      }
    },
    "config_source": {
      "type": "string",
      "description": "Path of the strategy config the detector was extracted from."
    },
    "per_symbol_per_timeframe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "timeframe", "metrics", "confidence"],
        "additionalProperties": false,
        "properties": {
          "symbol":    {"type": "string"},
          "timeframe": {"type": "string"},
          "metrics": {
            "type": "object",
            "required": [
              "regime_persistence_median_bars",
              "transition_frequency_per_window",
              "parameter_sensitivity",
              "trending_activation_rate",
              "zero_trade_slot_pct",
              "class_conditional_sensitivity_per_label",
              "activation_band_check"
            ],
            "additionalProperties": false,
            "properties": {
              "regime_persistence_median_bars":  {"type": "number"},
              "transition_frequency_per_window": {"type": "number"},
              "parameter_sensitivity":           {"type": "number"},
              "trending_activation_rate":        {"type": "number"},
              "zero_trade_slot_pct":             {"type": "number"},
              "agreement_with_reference_labels": {"type": ["number", "null"]},
              "class_conditional_sensitivity_per_label": {
                "type": "object",
                "description": "Worst-case class-conditional sensitivity per regime label. Fraction of baseline-label bars that lose the label under +-10% threshold perturbation. Keys are label names.",
                "additionalProperties": {
                  "type": "object",
                  "required": ["baseline_count", "class_conditional_sensitivity", "worst_case_direction", "relative_population_change"],
                  "additionalProperties": false,
                  "properties": {
                    "baseline_count":                {"type": "integer"},
                    "class_conditional_sensitivity": {"type": "number"},
                    "worst_case_direction":          {"type": "string"},
                    "relative_population_change":    {"type": "number"}
                  }
                }
              },
              "activation_band_check": {
                "type": "object",
                "description": "Whether trending_activation_rate falls within the plausibility band [band_min, band_max]. Confidence is capped at medium when outside the band.",
                "required": ["within_band", "band_min", "band_max", "rare_label_threshold", "gate_metric_used"],
                "additionalProperties": false,
                "properties": {
                  "within_band":          {"type": "boolean"},
                  "band_min":             {"type": "number"},
                  "band_max":             {"type": "number"},
                  "rare_label_threshold": {"type": "number"},
                  "gate_metric_used":     {"type": "string", "enum": ["class_conditional", "all_bars"]}
                }
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confidence_rationale": {"type": "string"},
          "known_weak_periods": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Date ranges (YYYY-MM) where detector confidence is locally low. Seeded from zero-trade-slot months per A2.1."
          }
        }
      }
    }
  }
}
