{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["hypothesis_id", "stage", "status", "rationale"],
  "properties": {
    "hypothesis_id": {"type": "string"},
    "stage": {"type": "string"},
    "status": {"type": "string", "description": "stage-specific verdict, e.g. spec_ready | component_gap"},
    "rationale": {"type": "string"},
    "blocking_issues": {"type": "array", "items": {"type": "string"}},
    "tried": {"type": "array", "description": "O-21 (strategy_config_authoring, component_gap): the compositions tried, each with the card clause it fails; at least one uses the transform pipeline."}
  }
}
