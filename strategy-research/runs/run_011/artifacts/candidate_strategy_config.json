            },
            {
              "id": "vr",
              "op": "lte",
              "value": 0.9
            }
          ]
        ]
      },
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "er",
              "op": "gte",
              "value": 0.25
            }
          ]
        ]
      },
      {
        "regime": "chop",
        "any_of": [
          [
            {
              "id": "vr",
              "op": "gte",
              "value": 1.1
            }
          ]
        ]
      }
    ]
  },
  "strategies": {
