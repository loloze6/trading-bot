{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "er",
        "class": "strategies.strategy_components.EfficiencyRatioRegimeComponent",
        "params": {
          "period": 24,
          "smooth_period": 5
        }
      },
      {
        "id": "vr",
        "class": "strategies.strategy_components.VarianceRatioComponent",
        "params": {
          "k": 5,
          "window": 100
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "er",
              "op": "lte",
              "value": 0.2
            },
            {
              "id": "vr",
              "op": "lte",
              "value": 0.9
            }
          ]
        ]
      },
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "er",
              "op": "gte",
              "value": 0.25
            },
            {
              "id": "vr",
              "op": "gte",
              "value": 1.1
            }
          ],
          [
            {
              "id": "er",
              "op": "gte",
              "value": 0.3
            },
            {
              "id": "vr",
              "op": "between",
              "low": 0.9,
              "high": 1.1
            }
          ]
        ]
      },
      {
        "regime": "chop",
        "any_of": [
          [
            {
              "id": "er",
              "op": "between",
              "low": 0.2,
              "high": 0.25
            },
            {
              "id": "vr",
              "op": "between",
              "low": 0.85,
              "high": 1.15
            }
          ]
        ]
      }
    ],
    "default_regime": "mean_reversion"
  },
  "strategies": {
    "warmup": 51,
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "rsi_pullback",
            "class": "strategies.strategy_components.RSIPullbackComponent",
            "params": {
              "period": 14,
              "scaling_factor": 0.4,
              "long_only": true
            },
            "weight": 1.0,
            "lookback": 500,
            "history_transforms": [
              {
                "op": "vol_normalize"
              }
            ],
            "transforms": [
              {
                "op": "ratio_to_mean"
              },
              {
                "op": "scale",
                "params": {
                  "factor": 10.0
                }
              },
              {
                "op": "threshold_filter",
                "params": {
                  "min_abs": 15.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    }
  }
}