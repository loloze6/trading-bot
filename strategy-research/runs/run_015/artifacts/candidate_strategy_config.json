{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "er",
        "class": "strategies.strategy_components.EfficiencyRatioRegimeComponent",
        "params": {
          "period": 24,
          "smooth_period": 5
        }
      },
      {
        "id": "vr",
        "class": "strategies.strategy_components.VarianceRatioComponent",
        "params": {
          "k": 5,
          "window": 100
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "er",
              "op": "gte",
              "value": 0.5
            },
            {
              "id": "vr",
              "op": "gte",
              "value": 1.2
            }
          ]
        ]
      },
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "vr",
              "op": "lt",
              "value": 0.9
            }
          ]
        ]
      },
      {
        "regime": "chop",
        "any_of": [
          [
            {
              "id": "er",
              "op": "lt",
              "value": 0.25
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "warmup": 51,
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "keltner",
            "class": "strategies.strategy_components.KeltnerBreakoutComponent",
            "params": {
              "ema_period": 20,
              "atr_period": 20,
              "atr_multiplier": 2.0,
              "scaling_factor": 20.0
            },
            "weight": 1.0,
            "lookback": 500,
            "transforms": [
              {
                "op": "ratio_to_mean"
              },
              {
                "op": "scale",
                "params": {
                  "factor": 10.0
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    }
  }
}