{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "er",
        "class": "strategies.strategy_components.EfficiencyRatioRegimeComponent",
        "params": {
          "period": 24,
          "smooth_period": 5
        }
      },
      {
        "id": "vr",
        "class": "strategies.strategy_components.VarianceRatioComponent",
        "params": {
          "k": 5,
          "window": 100
        }
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "er",
              "op": "lte",
              "value": 0.2
            },
            {
              "id": "vr",
              "op": "lte",
              "value": 0.9
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "warmup": 51,
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "rsi",
            "class": "strategies.strategy_components.RSIPullbackComponent",
            "params": {
              "period": 14,
              "scaling_factor": 0.01,
              "long_only": true
            },
            "weight": 1.0,
            "lookback": 500,
            "transforms": []
          }
        ]
      },
      "trending": null,
      "chop": null
    }
  }
}