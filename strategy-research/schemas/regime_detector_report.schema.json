{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regime Detector Report",
  "description": "Campaign-scoped standalone validation of the regime detector, independent of any hypothesis.",
  "type": "object",
  "required": ["detector_version", "evaluated_at", "data_range", "per_symbol_per_timeframe"],
  "additionalProperties": false,
  "properties": {
    "detector_version": {
      "type": "string",
      "description": "SHA8 of the detector config JSON, so staleness is detectable."
    },
    "evaluated_at": {"type": "string"},
    "data_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end":   {"type": "string"}
      }
    },
    "config_source": {
      "type": "string",
      "description": "Path of the strategy config the detector was extracted from."
    },
    "per_symbol_per_timeframe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "timeframe", "metrics", "confidence"],
        "additionalProperties": false,
        "properties": {
          "symbol":    {"type": "string"},
          "timeframe": {"type": "string"},
          "metrics": {
            "type": "object",
            "required": [
              "regime_persistence_median_bars",
              "transition_frequency_per_window",
              "parameter_sensitivity",
              "trending_activation_rate",
              "zero_trade_slot_pct"
            ],
            "additionalProperties": false,
            "properties": {
              "regime_persistence_median_bars":  {"type": "number"},
              "transition_frequency_per_window": {"type": "number"},
              "parameter_sensitivity":           {"type": "number"},
              "trending_activation_rate":        {"type": "number"},
              "zero_trade_slot_pct":             {"type": "number"},
              "agreement_with_reference_labels": {"type": ["number", "null"]}
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confidence_rationale": {"type": "string"},
          "known_weak_periods": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Date ranges (YYYY-MM) where detector confidence is locally low. Seeded from zero-trade-slot months per A2.1."
          }
        }
      }
    }
  }
}
