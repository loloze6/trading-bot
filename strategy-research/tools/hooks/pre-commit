#!/bin/sh
# Pre-commit hook — VERSIONED SOURCE OF TRUTH.
#
# .git/hooks/ is not tracked by git, so a fresh clone gets NO hooks. Install with the
# one-time setup script (it just sets core.hooksPath at this directory):
#
#     sh strategy-research/tools/setup_hooks.sh
#
# WHAT THIS HOOK IS FOR (scope decided 2026-08-18, Jeremy — E-003 S2b)
#   It gates the two things a commit can make PERMANENT, and nothing else.
#   A secret or a sealed-window date, once committed, is in your local history: getting
#   it out needs a history rewrite (see the .env incident — untracked 2026-07-25, still
#   present in commit 91087ed). CI cannot help there; it can reject a push, it cannot
#   un-write a commit that already exists on your disk. So these two checks must run
#   BEFORE the commit, locally, and they cost ~6 seconds combined.
#
#   The test suite is deliberately NOT here. It used to be (as "gate 2"), and it was
#   both broken and misplaced:
#     * BROKEN — it hardcoded "$ROOT/venv/Scripts/python", a Windows path. On macOS and
#       Linux that interpreter does not exist, sh returns 127, and 127 is not in the
#       hook's explicit 1/2/3 failure check — so the hook printed "Tests passed" having
#       run nothing at all. A gate that lies is worse than a gate that is absent.
#     * MISPLACED — it ran only the trading-bot suite, never strategy-research (the
#       exact double-gating gap run_tests.py exists to close), and it cost ~1 minute per
#       commit. A one-minute pre-commit hook is the classic thing people --no-verify
#       past, and a routinely-bypassed gate is worse than no gate (this file's own
#       holdout-gate docstring makes the same argument).
#   Both suites now run in CI (.github/workflows/tests.yml) on every push and pull
#   request, which is where a slow, non-destructive check belongs. A failing test
#   damages nothing and is fixed by committing again.
#
# Two gates, in increasing order of cost:
#   0. Secret scan — blocks committing secrets: forbidden files (.env, venv/, *.key) and
#      credential VALUES in the staged diff (AWS, Gemini, PEM private keys, quoted
#      api_secret, and BINANCE/GEMINI key=value). Value-required: a bare env-var NAME in a
#      comment or code reference is NOT flagged, only a name paired with an actual value.
#      Added 2026-08-15 (E-003 S3): folds the previously local-only, tightened
#      secret-scanner into the tracked hook so core.hooksPath ships it alongside the
#      holdout gate to every clone. Runs first: cheapest, and a leaked credential is the
#      highest-severity block.
#      Forbidden-file check is scoped to ADD/MODIFY/COPY (`--diff-filter=ACMR`), not
#      DELETE (E-006 unblock, 2026-09-09): the rationale above is "blocks the two things
#      a commit can make PERMANENT" — a deletion of an already-tracked file cannot create
#      any NEW permanent history, the old blob is already permanent in history either way.
#      A path-only match (no diff-filter) accidentally blocked pure deletions too, which
#      made `git rm --cached` on a committed venv/ impossible without --no-verify.
#   1. Holdout date gate — blocks any commit publishing a date inside the sealed
#      window 2026-01-01..2026-06-30 (campaign_data_policy.yaml:holdout_range).
#      Added 2026-07-26 by dispatch W5 after two backtest run directories were found
#      to have crossed the boundary. Fails CLOSED: if it cannot prove a clean scan,
#      it blocks. Also enforced in CI, so a PR merged through GitHub's web UI — which
#      never invokes this hook — is covered too.
#
# Emergency bypass for all: git commit --no-verify

ROOT=$(git rev-parse --show-toplevel) || exit 1

# --- 0. Secret scan -------------------------------------------------------------
# Forbidden files by path (secrets/venv policy). --diff-filter=ACMR: only additions,
# modifications, copies and renames can introduce NEW permanent content; a pure
# deletion (D) cannot, so it does not need this override (E-006, 2026-09-09).
for f in $(git diff --cached --diff-filter=ACMR --name-only); do
    case "$f" in
        .env|*.env|venv/*|*.key)
            echo "COMMIT BLOCKED: refusing to commit '$f' (secrets/venv policy)." >&2
            echo "Emergency bypass: git commit --no-verify" >&2
            exit 1
            ;;
    esac
done
# Credential VALUES in the staged diff. Env-var NAMES require an actual value assignment
# (name + value) to count -- a bare name in a comment or code reference is not a leak. The
# key VALUE formats (AWS AKIA, Gemini AIza, PEM, quoted api_secret) match on their own.
# This hook file is excluded from its own scan so its detector patterns cannot self-trip.
if git diff --cached -- . ':(exclude)strategy-research/tools/hooks/pre-commit' \
    | grep -E -q '((BINANCE_API_(KEY|SECRET)|GEMINI_API_KEY)\s*[:=]\s*["\x27]?[A-Za-z0-9._+/-]{16,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|-----BEGIN (RSA |EC )?PRIVATE KEY|api_secret\s*=\s*["\x27][A-Za-z0-9+/]{20,})'; then
    echo "COMMIT BLOCKED: staged diff contains what looks like a credential. Remove it (and rotate if real)." >&2
    echo "Emergency bypass: git commit --no-verify" >&2
    exit 1
fi

# --- 1. Holdout date gate -------------------------------------------------------
GATE="$ROOT/strategy-research/tools/holdout_date_gate.sh"

# Deny by default: a missing gate is not a passing gate.
if [ ! -f "$GATE" ]; then
    echo "COMMIT BLOCKED: $GATE is missing." >&2
    echo "The holdout gate cannot be skipped by deleting it. Restore it, or use" >&2
    echo "--no-verify and explain why in the commit message." >&2
    exit 1
fi

sh "$GATE" || exit 1

# Tests are NOT run here on purpose — see WHAT THIS HOOK IS FOR at the top of this
# file. They run in CI on every push and pull request.
exit 0
