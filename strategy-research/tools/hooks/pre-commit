#!/bin/sh
# Pre-commit hook — VERSIONED SOURCE OF TRUTH.
#
# .git/hooks/ is not tracked by git, so a fresh clone gets NO hooks and would silently
# lose the checks below. This file is the copy under version control; install it with:
#
#     cp strategy-research/tools/hooks/pre-commit .git/hooks/pre-commit
#     chmod +x .git/hooks/pre-commit
#
# (or, once, point Git at the tracked directory so a clone needs no manual copy:
#     git config core.hooksPath strategy-research/tools/hooks)
#
# Three gates, in increasing order of cost:
#   0. Secret scan — blocks committing secrets: forbidden files (.env, venv/, *.key) and
#      credential VALUES in the staged diff (AWS, Gemini, PEM private keys, quoted
#      api_secret, and BINANCE/GEMINI key=value). Value-required: a bare env-var NAME in a
#      comment or code reference is NOT flagged, only a name paired with an actual value.
#      Added 2026-08-15 (E-003 S3): folds the previously local-only, tightened
#      secret-scanner into the tracked hook so core.hooksPath ships it alongside the
#      holdout gate to every clone. Runs first: cheapest, and a leaked credential is the
#      highest-severity block.
#   1. Holdout date gate — blocks any commit publishing a date inside the sealed
#      window 2026-01-01..2026-06-30 (campaign_data_policy.yaml:holdout_range).
#      Added 2026-07-26 by dispatch W5 after two backtest run directories were found
#      to have crossed the boundary. Fails CLOSED: if it cannot prove a clean scan,
#      it blocks.
#   2. Test suite — the pre-existing check.
#
# Emergency bypass for all: git commit --no-verify

ROOT=$(git rev-parse --show-toplevel) || exit 1

# --- 0. Secret scan -------------------------------------------------------------
# Forbidden files by path (secrets/venv policy).
for f in $(git diff --cached --name-only); do
    case "$f" in
        .env|*.env|venv/*|*.key)
            echo "COMMIT BLOCKED: refusing to commit '$f' (secrets/venv policy)." >&2
            echo "Emergency bypass: git commit --no-verify" >&2
            exit 1
            ;;
    esac
done
# Credential VALUES in the staged diff. Env-var NAMES require an actual value assignment
# (name + value) to count -- a bare name in a comment or code reference is not a leak. The
# key VALUE formats (AWS AKIA, Gemini AIza, PEM, quoted api_secret) match on their own.
# This hook file is excluded from its own scan so its detector patterns cannot self-trip.
if git diff --cached -- . ':(exclude)strategy-research/tools/hooks/pre-commit' \
    | grep -E -q '((BINANCE_API_(KEY|SECRET)|GEMINI_API_KEY)\s*[:=]\s*["\x27]?[A-Za-z0-9._+/-]{16,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|-----BEGIN (RSA |EC )?PRIVATE KEY|api_secret\s*=\s*["\x27][A-Za-z0-9+/]{20,})'; then
    echo "COMMIT BLOCKED: staged diff contains what looks like a credential. Remove it (and rotate if real)." >&2
    echo "Emergency bypass: git commit --no-verify" >&2
    exit 1
fi

# --- 1. Holdout date gate -------------------------------------------------------
GATE="$ROOT/strategy-research/tools/holdout_date_gate.sh"

# Deny by default: a missing gate is not a passing gate.
if [ ! -f "$GATE" ]; then
    echo "COMMIT BLOCKED: $GATE is missing." >&2
    echo "The holdout gate cannot be skipped by deleting it. Restore it, or use" >&2
    echo "--no-verify and explain why in the commit message." >&2
    exit 1
fi

sh "$GATE" || exit 1

# --- 2. Test suite --------------------------------------------------------------
echo "Running tests before commit..."

cd "$ROOT/trading-bot" || exit 1

"$ROOT/venv/Scripts/python" -m pytest tests/ -q --tb=short 2>&1

EXIT_CODE=$?

# pytest exit codes:
#   0 = all tests passed
#   1 = some tests failed
#   2 = interrupted
#   3 = internal error
#   4 = usage error
#   5 = no tests collected (OK while test suite is still being built)

if [ $EXIT_CODE -eq 1 ] || [ $EXIT_CODE -eq 2 ] || [ $EXIT_CODE -eq 3 ]; then
    echo ""
    echo "COMMIT BLOCKED: tests failed. Fix the tests above before committing."
    echo "To bypass in an emergency: git commit --no-verify"
    exit 1
fi

echo "Tests passed (or none collected yet)."
exit 0
