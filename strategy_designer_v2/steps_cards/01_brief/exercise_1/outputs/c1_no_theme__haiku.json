ders are used up, the price has no further push and tends to revert toward the prior range. Market makers and arbitrage traders who supply liquidity near these levels are the ones paid for absorbing this flow, so they set the reversion. The theory would be wrong if overshoots past round-number levels are followed by continuation as often as by reversion, or if the reversion is no larger than for ordinary price moves of the same size.\n\nshort-name: round-number-overshoot-reversion\nother-theories: none","ttft_ms":2510,"type":"result","duration_ms":4334,"uuid":"f391617c-60f9-4f48-bafd-4a5159706631","ttft_stream_ms":885,"time_to_request_ms":203,"time_to_request_phases_ms":{"other":5,"system_prompt":1,"resume_other":0,"process_user_input":6,"input_attachments":20,"input_hooks":11,"conversation_append":13,"tool_pool_refresh":1,"init_message":2,"init_frame_send":14,"engine_pickup":1,"loop_entry":11,"message_prep":1,"model_config_wait":72,"autocompact":1,"request_announcements":17,"query_setup":5,"model_gates":0,"tool_schema_build":4,"message_normalization":7,"client_creation":6,"request_build":5},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":84,"time_to_request_cpu_ms":71,"time_to_request_major_faults":3,"process_rss_mib_turn_start":196,"process_anon_mib_turn_start":124,"process_rss_mib_result":188,"process_anon_mib_result":112,"process_peak_rss_mib":200,"process_cpu_ms_turn":280,"process_wall_ms_turn":4333,"process_cpu_ms_streaming":49,"process_wall_ms_streaming":1635,"main_stream_count":1,"main_stream_event_count":87,"main_stream_chunk_count":74,"process_turn_states":{"main_stream":{"cpu_ms":49,"wall_ms":1635,"entries":1},"side_stream":{"cpu_ms":14,"wall_ms":208,"entries":1},"first_event_wait":{"cpu_ms":105,"wall_ms":474,"entries":2},"before_first_request":{"cpu_ms":71,"wall_ms":202,"entries":1},"after_last_request":{"cpu_ms":41,"wall_ms":1814,"entries":1}},"input_attachments_detail":{"slowest_producer":"session_settings","slowest