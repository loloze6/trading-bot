{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "ma50",
        "class": "strategies.strategy_components.MovingAverageDistanceComponent",
        "params": {
          "period": 50,
          "average": "sma"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "ma50",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "vol_swell",
            "class": "strategies.strategy_components.VolumeRatioComponent",
            "params": {
              "period": 30,
              "short_period": 14,
              "exclude_current": 0,
              "form": "centred",
              "statistic": "mean",
              "short_statistic": "mean"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "unknown": null,
      "mean_reversion": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 14
  }
}
