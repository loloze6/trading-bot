{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "volr",
        "class": "strategies.strategy_components.VolumeRatioComponent",
        "params": {
          "period": 30,
          "short_period": 14,
          "exclude_current": 0,
          "form": "ratio"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "volr",
              "op": "gte",
              "value": 1.0
            }
          ]
        ]
      },
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "volr",
              "op": "lt",
              "value": 1.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "follow",
            "class": "strategies.strategy_components.RecentToPriorVolumeScaledReturnComponent",
            "params": {
              "period": 14,
              "window": 365,
              "base_period": 16
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 379,
                  "min_periods": 95
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": {
        "components": [
          {
            "id": "fade",
            "class": "strategies.strategy_components.ThinVolumeScaledReturnComponent",
            "params": {
              "period": 14,
              "window": 365,
              "volume_period": 14,
              "base_near": 14,
              "base_far": 29
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 379,
                  "min_periods": 95
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "unknown": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 14
  }
}
