{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "volratio",
        "class": "strategies.strategy_components.VolatilityRatioToAverageComponent",
        "params": {
          "vol_period": 20,
          "vol_lookback": 60
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "volratio",
              "op": "gte",
              "value": 1.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "scaled_move",
            "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
            "params": {
              "period": 1,
              "vol_period": 20,
              "lag": 0
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    }
  }
}
