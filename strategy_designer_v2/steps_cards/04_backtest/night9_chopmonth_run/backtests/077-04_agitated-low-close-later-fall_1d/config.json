{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "cl_prev",
        "class": "strategies.strategy_components.CloseLocationInRangeComponent",
        "params": {
          "reference": "high",
          "lag": 1
        }
      },
      {
        "id": "profile_swing",
        "class": "strategies.strategy_components.VolatilityPercentileRegimeComponent",
        "params": {
          "vol_period": 30,
          "lookback_period": 365,
          "smooth_period": 1
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "cl_prev",
              "op": "gte",
              "value": 0.75
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown",
    "vetoes": [
      {
        "id": "profile_swing",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "lte",
            "value": 0.5
          }
        ],
        "result": "chop"
      }
    ]
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "low_close",
            "class": "strategies.strategy_components.CloseLocationInRangeComponent",
            "params": {
              "reference": "high",
              "lag": 1
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 6
  }
}
