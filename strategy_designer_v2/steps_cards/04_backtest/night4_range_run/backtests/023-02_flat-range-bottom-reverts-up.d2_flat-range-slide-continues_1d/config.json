{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "flat",
        "class": "strategies.strategy_components.NetMoveToRangeRatioComponent",
        "params": {
          "period": 30,
          "source": "high_low"
        }
      },
      {
        "id": "mid",
        "class": "strategies.strategy_components.IchimokuCloudPositionComponent",
        "params": {
          "tenkan_period": 30,
          "kijun_period": 30,
          "senkou_period": 30,
          "displacement": 0,
          "edge": "top",
          "base": "close"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "flat",
              "op": "lte",
              "value": 0.5
            },
            {
              "id": "mid",
              "op": "lt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "fall10",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 10
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "max": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
