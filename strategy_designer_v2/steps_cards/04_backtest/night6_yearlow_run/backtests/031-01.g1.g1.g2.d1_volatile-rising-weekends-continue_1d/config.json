{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "wd",
        "class": "strategies.strategy_components.WeekdayComponent",
        "params": {}
      },
      {
        "id": "vr",
        "class": "strategies.strategy_components.RecentToPriorVolatilityRatioComponent",
        "params": {
          "vol_period": 20,
          "base_period": 60,
          "base_lag": 0,
          "form": "ratio"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "wd",
              "op": "between",
              "low": 4.5,
              "high": 5.5
            },
            {
              "id": "vr",
              "op": "gt",
              "value": 1.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "rise_vol",
            "class": "strategies.strategy_components.RecentToPriorVolatilityWeightedReturnComponent",
            "params": {
              "period": 14,
              "vol_period": 20,
              "base_period": 60,
              "base_lag": 0
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 61,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 2
  }
}
