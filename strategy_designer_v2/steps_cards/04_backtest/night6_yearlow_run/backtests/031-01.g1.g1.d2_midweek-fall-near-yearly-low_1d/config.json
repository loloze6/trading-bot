{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "wd",
        "class": "strategies.strategy_components.WeekdayComponent",
        "params": {}
      },
      {
        "id": "yr",
        "class": "strategies.strategy_components.DonchianBreakoutComponent",
        "params": {
          "period": 365
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "wd",
              "op": "between",
              "low": 4.5,
              "high": 5.5
            },
            {
              "id": "yr",
              "op": "lt",
              "value": 0.0
            }
          ]
        ]
      },
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "wd",
              "op": "between",
              "low": 4.5,
              "high": 5.5
            },
            {
              "id": "yr",
              "op": "gte",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "midweek_low",
            "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
            "params": {
              "period": 3,
              "lag": 1,
              "vol_period": 20
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              }
            ]
          }
        ]
      },
      "trending": {
        "components": [
          {
            "id": "midweek_high",
            "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
            "params": {
              "period": 3,
              "lag": 1,
              "vol_period": 20
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "unknown": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
