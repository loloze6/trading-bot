{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "up",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 1,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "rng",
        "class": "strategies.strategy_components.DonchianBreakoutComponent",
        "params": {
          "period": 20,
          "scaling_factor": 1.0,
          "source": "high_low",
          "form": "position",
          "exclude_current": 0
        }
      },
      {
        "id": "profile_trend",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 60,
          "scaling_factor": 1.0
        }
      }
    ],
    "vetoes": [
      {
        "id": "profile_trend",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "gte",
            "value": -10
          }
        ],
        "result": "chop"
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "up",
              "op": "gt",
              "value": 0.0
            },
            {
              "id": "rng",
              "op": "lt",
              "value": -0.6
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "agit",
            "class": "strategies.strategy_components.VolatilityRatioToAverageComponent",
            "params": {
              "vol_period": 30,
              "vol_lookback": 365
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 365,
                  "min_periods": 91
                }
              },
              {
                "op": "signed_power",
                "params": {
                  "exponent": 2
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "max": 0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
