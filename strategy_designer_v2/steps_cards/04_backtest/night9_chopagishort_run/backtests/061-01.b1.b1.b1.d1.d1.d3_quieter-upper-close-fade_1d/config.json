{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "trend60",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 60,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "agit",
        "class": "strategies.strategy_components.VolatilityPercentileRegimeComponent",
        "params": {
          "vol_period": 30,
          "lookback_period": 365,
          "smooth_period": 1
        }
      },
      {
        "id": "loc",
        "class": "strategies.strategy_components.CloseLocationInRangeComponent",
        "params": {
          "reference": "low"
        }
      },
      {
        "id": "ret5",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 5,
          "scaling_factor": 1.0
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "trend60",
              "op": "between",
              "low": -10.0,
              "high": 10.0
            },
            {
              "id": "agit",
              "op": "gt",
              "value": 0.5
            },
            {
              "id": "loc",
              "op": "gt",
              "value": 0.5
            },
            {
              "id": "ret5",
              "op": "lt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
