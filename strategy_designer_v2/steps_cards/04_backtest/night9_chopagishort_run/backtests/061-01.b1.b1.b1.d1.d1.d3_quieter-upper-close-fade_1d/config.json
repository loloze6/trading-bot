      "mean_reversion": {
        "components": [
          {
            "id": "calm_fall",
            "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
            "params": {
              "period": 5,
              "vol_period": 20,
              "lag": 0,
              "vol_lookback": 1
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "max": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
