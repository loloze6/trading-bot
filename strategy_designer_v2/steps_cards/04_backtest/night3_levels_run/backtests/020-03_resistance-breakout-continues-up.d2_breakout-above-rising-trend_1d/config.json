{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "brk",
        "class": "strategies.strategy_components.ResistanceBreakTouchCountComponent",
        "params": {
          "period": 90,
          "side": 2,
          "band": 2.0,
          "cross_period": 1
        }
      },
      {
        "id": "clu",
        "class": "strategies.strategy_components.SwingHighClusterCountComponent",
        "params": {
          "period": 90,
          "side": 2,
          "band": 2.0,
          "form": "count",
          "level": "below",
          "pivot": "high",
          "exclude_current": 0
        }
      },
      {
        "id": "mad",
        "class": "strategies.strategy_components.MovingAverageDistanceComponent",
        "params": {
          "period": 50,
          "average": "sma"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "brk",
              "op": "gt",
              "value": 0.0
            },
            {
              "id": "clu",
              "op": "gte",
              "value": 2
            },
            {
              "id": "mad",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "ma_dist",
            "class": "strategies.strategy_components.MovingAverageDistanceComponent",
            "params": {
              "period": 50,
              "average": "sma"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
