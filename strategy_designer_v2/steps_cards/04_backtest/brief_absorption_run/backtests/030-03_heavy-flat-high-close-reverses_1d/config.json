{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "volr",
        "class": "strategies.strategy_components.VolumeRatioComponent",
        "params": {
          "period": 20,
          "exclude_current": 1
        }
      },
      {
        "id": "body",
        "class": "strategies.strategy_components.BarBodySizeComponent",
        "params": {
          "relative_to": "open",
          "form": "body"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "volr",
              "op": "gte",
              "value": 2.0
            },
            {
              "id": "body",
              "op": "lte",
              "value": 1.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "absorb_loc",
            "class": "strategies.strategy_components.VolumeWeightedCloseLocationComponent",
            "params": {
              "volume_period": 20,
              "exclude_current": 1,
              "reference": "low"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20,
                  "target": 5
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
