{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "vr",
        "class": "strategies.strategy_components.VolumeRatioComponent",
        "params": {
          "period": 20,
          "exclude_current": 1
        }
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "vr",
              "op": "gte",
              "value": 2.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "loc_from_high",
            "class": "strategies.strategy_components.CloseLocationInRangeComponent",
            "params": {
              "reference": "high"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "unknown": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
