{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "brk",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 365,
          "source": "close",
          "exclude_current": 1,
          "form": "percent"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "brk",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "volratio",
            "class": "strategies.strategy_components.VolumeRatioComponent",
            "params": {
              "period": 90,
              "exclude_current": 1,
              "short_period": 1,
              "form": "ratio",
              "statistic": "mean"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 90,
                  "min_periods": 22
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    }
  }
}
