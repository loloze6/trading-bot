{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "newhigh",
        "class": "strategies.strategy_components.BarsSinceHighComponent",
        "params": {
          "lookback": 60,
          "max_bars": 20
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "newhigh",
              "op": "gte",
              "value": 19.5
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "runup",
            "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
            "params": {
              "period": 20,
              "vol_period": 20,
              "lag": 1,
              "vol_lookback": 1
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": -10.0
                }
              }
            ]
          },
          {
            "id": "offset",
            "class": "strategies.strategy_components.BuyAndHoldStrategy",
            "params": {},
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              }
            ]
          }
        ]
      },
      "unknown": null,
      "mean_reversion": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 20
  }
}
