{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "dh",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 28,
          "source": "close",
          "exclude_current": 0,
          "form": "percent"
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "dh",
              "op": "gte",
              "value": -1e-06
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "compress",
            "class": "strategies.strategy_components.RecentToPriorVolatilityRatioComponent",
            "params": {
              "vol_period": 20,
              "base_period": 60,
              "base_lag": 0,
              "form": "centred"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 61,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "unknown": null,
      "mean_reversion": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
