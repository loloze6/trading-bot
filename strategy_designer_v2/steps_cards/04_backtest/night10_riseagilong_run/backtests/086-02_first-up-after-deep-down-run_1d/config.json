{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "run",
        "class": "strategies.strategy_components.PriorDownRunOnUpCloseComponent",
        "params": {
          "max_bars": 30,
          "form": "count",
          "side": "down"
        }
      },
      {
        "id": "profile_trend",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 60,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "profile_swing",
        "class": "strategies.strategy_components.VolatilityPercentileRegimeComponent",
        "params": {
          "vol_period": 30,
          "lookback_period": 365,
          "smooth_period": 1
        }
      }
    ],
    "vetoes": [
      {
        "id": "profile_trend",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "lte",
            "value": 10
          }
        ],
        "result": "chop"
      },
      {
        "id": "profile_swing",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "lte",
            "value": 0.5
          }
        ],
        "result": "chop"
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "run",
              "op": "gte",
              "value": 2
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "depth",
            "class": "strategies.strategy_components.PriorDownRunLossOnUpCloseComponent",
            "params": {
              "max_bars": 30,
              "base": "std",
              "window": 30,
              "exclude_current": 1,
              "side": "down"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
