{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "brk",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 12,
          "source": "high",
          "exclude_current": 1,
          "form": "percent",
          "extreme": "low"
        }
      },
      {
        "id": "mom",
        "class": "strategies.strategy_components.PriceEvolutionOnPeriodComponent",
        "params": {
          "comparison_period": 180
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "brk",
              "op": "lt",
              "value": 0.0
            },
            {
              "id": "mom",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "width",
            "class": "strategies.strategy_components.RangeCompressionRatioComponent",
            "params": {
              "short_period": 12,
              "long_period": 180,
              "exclude_current": 2,
              "form": "width",
              "base": "mean_bar_range"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 180,
                  "min_periods": 45
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 360,
      "target_annual_vol": 0.382099,
      "periods_per_year": 2190,
      "max_allocation": 2
    },
    "min_holding_bars": 18
  }
}
