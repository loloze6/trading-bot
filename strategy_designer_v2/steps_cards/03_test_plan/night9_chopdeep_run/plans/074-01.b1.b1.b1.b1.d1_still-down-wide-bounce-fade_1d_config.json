{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "trend60",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 60,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "ret1",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 1,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "ret5",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 5,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "wide",
        "class": "strategies.strategy_components.RangeCompressionRatioComponent",
        "params": {
          "short_period": 1,
          "long_period": 20,
          "exclude_current": 0,
          "form": "width",
          "base": "mean_bar_range"
        }
      },
      {
        "id": "loc",
        "class": "strategies.strategy_components.CloseLocationInRangeComponent",
        "params": {
          "reference": "low"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "trend60",
              "op": "lt",
              "value": -10.0
            },
            {
              "id": "ret1",
              "op": "gt",
              "value": 0.0
            },
            {
              "id": "ret5",
              "op": "lt",
              "value": 0.0
            },
            {
              "id": "wide",
              "op": "gte",
              "value": 1.5
            },
            {
              "id": "loc",
              "op": "gte",
              "value": 0.75
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "depth5",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 5,
              "scaling_factor": 1.0
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "max": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
