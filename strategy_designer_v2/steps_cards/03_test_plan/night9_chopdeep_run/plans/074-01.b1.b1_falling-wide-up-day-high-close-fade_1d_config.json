{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "ret1",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 1,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "rangemult",
        "class": "strategies.strategy_components.RangeCompressionRatioComponent",
        "params": {
          "short_period": 1,
          "long_period": 20,
          "exclude_current": 0,
          "form": "width",
          "base": "mean_bar_range"
        }
      },
      {
        "id": "profile_trend",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 60,
          "scaling_factor": 1.0
        }
      }
    ],
    "vetoes": [
      {
        "id": "profile_trend",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "gte",
            "value": -10
          }
        ],
        "result": "chop"
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "ret1",
              "op": "gt",
              "value": 0.0
            },
            {
              "id": "rangemult",
              "op": "gte",
              "value": 1.5
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "width",
            "class": "strategies.strategy_components.RangeCompressionRatioComponent",
            "params": {
              "short_period": 1,
              "long_period": 20,
              "exclude_current": 0,
              "form": "width",
              "base": "mean_bar_range"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          },
          {
            "id": "closeloc",
            "class": "strategies.strategy_components.CloseLocationInRangeComponent",
            "params": {
              "reference": "low"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
