{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "volp",
        "class": "strategies.strategy_components.VolatilityPercentileRegimeComponent",
        "params": {
          "vol_period": 20,
          "lookback_period": 100,
          "smooth_period": 5
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "volp",
              "op": "gte",
              "value": 0.5
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "drop",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 1
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              },
              {
                "op": "signed_power",
                "params": {
                  "exponent": 3,
                  "pivot": 20
                }
              }
            ]
          }
        ]
      },
      "unknown": {
        "components": [
          {
            "id": "drop",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 1
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              },
              {
                "op": "signed_power",
                "params": {
                  "exponent": 3,
                  "pivot": 20
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null
    }
  }
}
