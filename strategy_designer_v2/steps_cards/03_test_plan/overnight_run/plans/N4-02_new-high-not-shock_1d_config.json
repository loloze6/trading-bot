{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "range20",
        "class": "strategies.strategy_components.DonchianBreakoutComponent",
        "params": {
          "period": 20,
          "scaling_factor": 20.0
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "range20",
              "op": "gte",
              "value": 19.99
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "daysize",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 1
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              }
            ]
          }
        ]
      },
      "unknown": null,
      "mean_reversion": null,
      "chop": null
    }
  }
}
