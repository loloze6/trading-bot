{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "wd",
        "class": "strategies.strategy_components.WeekdayComponent",
        "params": {}
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "wd",
              "op": "between",
              "low": -0.5,
              "high": 0.5
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "sun_fall",
            "class": "strategies.strategy_components.PriceEvolutionOnPeriodComponent",
            "params": {
              "comparison_period": 1
            },
            "weight": 1.0,
            "lookback": 500,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 500,
                  "min_periods": 120
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 3
  }
}
