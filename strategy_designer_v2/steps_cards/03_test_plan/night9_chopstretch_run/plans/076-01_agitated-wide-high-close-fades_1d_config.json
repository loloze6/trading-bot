{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "range_mult",
        "class": "strategies.strategy_components.RangeCompressionRatioComponent",
        "params": {
          "short_period": 1,
          "long_period": 20,
          "exclude_current": 0,
          "form": "width",
          "base": "mean_bar_range"
        }
      },
      {
        "id": "close_loc",
        "class": "strategies.strategy_components.CloseLocationInRangeComponent",
        "params": {
          "reference": "low"
        }
      },
      {
        "id": "profile_swing",
        "class": "strategies.strategy_components.VolatilityPercentileRegimeComponent",
        "params": {
          "vol_period": 30,
          "lookback_period": 365,
          "smooth_period": 1
        }
      }
    ],
    "vetoes": [
      {
        "id": "profile_swing",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "lte",
            "value": 0.5
          }
        ],
        "result": "chop"
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "range_mult",
              "op": "gte",
              "value": 1.0
            },
            {
              "id": "close_loc",
              "op": "gte",
              "value": 0.5
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "wide_high_close",
            "class": "strategies.strategy_components.BreakoutInMeanRangesComponent",
            "params": {
              "period": 1,
              "base_period": 20,
              "side": "above",
              "high_current": 1,
              "base_exclude_current": 0,
              "source": "high",
              "extreme": "low"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "max": 0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
