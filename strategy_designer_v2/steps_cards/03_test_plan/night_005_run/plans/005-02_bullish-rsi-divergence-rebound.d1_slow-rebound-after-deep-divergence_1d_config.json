{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "newlow",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 30,
          "source": "close",
          "exclude_current": 1,
          "form": "percent",
          "extreme": "low"
        }
      },
      {
        "id": "rsigap",
        "class": "strategies.strategy_components.RsiChangeFromPriorLowComponent",
        "params": {
          "rsi_period": 14,
          "lookback": 30,
          "exclude": 3,
          "rsi_window": 100
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "newlow",
              "op": "lt",
              "value": 0.0
            },
            {
              "id": "rsigap",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "rsi_gap",
            "class": "strategies.strategy_components.RsiChangeFromPriorLowComponent",
            "params": {
              "rsi_period": 14,
              "lookback": 30,
              "exclude": 3,
              "rsi_window": 100
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          },
          {
            "id": "fall30",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 30
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    }
  }
}
