{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "er",
        "class": "strategies.strategy_components.EfficiencyRatioRegimeComponent",
        "params": {
          "period": 60,
          "smooth_period": 1
        }
      },
      {
        "id": "brk",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 60,
          "source": "high",
          "exclude_current": 1,
          "form": "percent",
          "extreme": "high"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "er",
              "op": "lte",
              "value": 0.3
            },
            {
              "id": "brk",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "flat",
            "class": "strategies.strategy_components.FlatnessWeightedRangePositionComponent",
            "params": {
              "period": 60,
              "source": "high_low"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          },
          {
            "id": "narrow",
            "class": "strategies.strategy_components.RangeCompressionRatioComponent",
            "params": {
              "short_period": 60,
              "long_period": 180,
              "exclude_current": 2,
              "form": "compression",
              "base": "range"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 180,
                  "min_periods": 45
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 20
