{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "brk",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 60,
          "source": "close",
          "exclude_current": 1,
          "form": "percent"
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "brk",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "margin",
            "class": "strategies.strategy_components.DistanceFromHighComponent",
            "params": {
              "period": 60,
              "source": "close",
              "exclude_current": 1,
              "form": "percent"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": -10.0
                }
              }
            ]
          },
          {
            "id": "offset",
            "class": "strategies.strategy_components.BuyAndHoldStrategy",
            "params": {},
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              }
            ]
          }
        ]
      },
      "unknown": null,
      "mean_reversion": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 20
  }
}
