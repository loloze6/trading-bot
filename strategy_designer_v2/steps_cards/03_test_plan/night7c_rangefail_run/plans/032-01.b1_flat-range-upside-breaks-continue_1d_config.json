      "chop": {
        "components": [
          {
            "id": "break",
            "class": "strategies.strategy_components.DistanceFromHighComponent",
            "params": {
              "period": 60,
              "source": "high",
              "exclude_current": 1,
              "form": "percent",
              "extreme": "high"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 61,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "mean_reversion": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 20
  }
