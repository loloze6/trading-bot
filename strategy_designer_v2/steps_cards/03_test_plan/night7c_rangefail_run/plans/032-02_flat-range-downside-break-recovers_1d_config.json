{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "er",
        "class": "strategies.strategy_components.EfficiencyRatioRegimeComponent",
        "params": {
          "period": 60,
          "smooth_period": 5
        }
      },
      {
        "id": "brk",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 60,
          "source": "high",
          "exclude_current": 1,
          "form": "percent",
          "extreme": "low"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "er",
              "op": "lte",
              "value": 0.3
            },
            {
              "id": "brk",
              "op": "lt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "depth",
            "class": "strategies.strategy_components.DistanceFromHighComponent",
            "params": {
              "period": 60,
              "source": "high",
              "exclude_current": 1,
              "form": "percent",
              "extreme": "low"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 10
  }
}
