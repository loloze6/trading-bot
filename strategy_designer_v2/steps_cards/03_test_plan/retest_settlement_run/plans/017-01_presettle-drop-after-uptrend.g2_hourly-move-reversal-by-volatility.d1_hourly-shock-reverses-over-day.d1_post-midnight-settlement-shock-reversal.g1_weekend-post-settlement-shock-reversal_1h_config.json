{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "hour",
        "class": "strategies.strategy_components.HourOfDayComponent",
        "params": {}
      },
      {
        "id": "wd",
        "class": "strategies.strategy_components.WeekdayComponent",
        "params": {}
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "hour",
              "op": "between",
