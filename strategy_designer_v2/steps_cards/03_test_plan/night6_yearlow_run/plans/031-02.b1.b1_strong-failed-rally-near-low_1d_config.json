{
  "regime_detector": {
    "mode": "score_product",
    "min_score": 0.5,
    "min_margin": 0.0,
    "components": [
      {
        "id": "dist_low",
        "class": "strategies.strategy_components.DistanceFromHighComponent",
        "params": {
          "period": 365,
          "source": "close",
          "exclude_current": 0,
          "form": "percent",
          "extreme": "low"
        }
      }
    ],
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "dist_low",
            "divisor": 1.0,
            "transforms": [
              {
                "op": "negate_percentile"
              }
            ]
          }
        ]
      }
    },
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "rally",
            "class": "strategies.strategy_components.PriceEvolutionComponent",
            "params": {
              "period": 60
            },
            "weight": 1.0,
            "lookback": 365,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 61,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "min": 0.0
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 20
  }
}
