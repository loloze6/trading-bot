{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "loc",
        "class": "strategies.strategy_components.CloseLocationInRangeComponent",
        "params": {
          "reference": "low"
        }
      },
      {
        "id": "up",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 1,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "prior_fall",
        "class": "strategies.strategy_components.FallGatedRangeMultipleComponent",
        "params": {
          "period": 1,
          "base_period": 20,
          "fall_period": 5,
          "lag": 1
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "loc",
              "op": "gte",
              "value": 0.75
            },
            {
              "id": "up",
              "op": "gt",
              "value": 0.0
            },
            {
              "id": "prior_fall",
              "op": "gt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "small_gain",
            "class": "strategies.strategy_components.MeanAbsScaledReturnComponent",
            "params": {
              "period": 1,
              "window": 20,
              "base": "mean_abs_return",
              "form": "centred"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "max": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
