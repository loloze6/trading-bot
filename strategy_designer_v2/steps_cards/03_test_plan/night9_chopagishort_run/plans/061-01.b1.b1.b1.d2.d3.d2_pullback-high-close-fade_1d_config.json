{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "day_move",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 1,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "prior_fall",
        "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
        "params": {
          "period": 3,
          "vol_period": 20,
          "lag": 1
        }
      },
      {
        "id": "close_loc",
        "class": "strategies.strategy_components.CloseLocationInRangeComponent",
        "params": {
          "reference": "low"
        }
      },
      {
        "id": "profile_trend",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 60,
          "scaling_factor": 1.0
        }
      },
      {
        "id": "profile_swing",
        "class": "strategies.strategy_components.VolatilityPercentileRegimeComponent",
        "params": {
          "vol_period": 30,
          "lookback_period": 365,
          "smooth_period": 1
        }
      }
    ],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "day_move",
              "op": "gt",
              "value": 0.0
            },
            {
              "id": "prior_fall",
              "op": "lt",
              "value": 0.0
            },
            {
              "id": "close_loc",
              "op": "gte",
              "value": 0.75
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown",
    "vetoes": [
      {
        "id": "profile_trend",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "lt",
            "value": -10
          }
        ],
        "result": "chop"
      },
      {
        "id": "profile_trend",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "gt",
            "value": 10
          }
        ],
        "result": "chop"
      },
      {
        "id": "profile_swing",
        "transforms": [
          {
            "op": "identity"
          }
        ],
        "rules": [
          {
            "op": "lte",
            "value": 0.5
          }
        ],
        "result": "chop"
      }
    ]
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "quiet_gain",
            "class": "strategies.strategy_components.MeanAbsScaledReturnComponent",
            "params": {
              "period": 1,
              "window": 20,
              "base": "mean_abs_return",
              "form": "centred"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "max": 0.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
