{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "ret20",
        "class": "strategies.strategy_components.PriceEvolutionComponent",
        "params": {
          "period": 20
        }
      }
    ],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "ret20",
              "op": "lt",
              "value": 0.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "close_loc",
            "class": "strategies.strategy_components.CloseLocationInRangeComponent",
            "params": {
              "reference": "low"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          },
          {
            "id": "range_mult",
            "class": "strategies.strategy_components.RangeCompressionRatioComponent",
            "params": {
              "short_period": 1,
              "long_period": 20,
              "exclude_current": 0,
              "form": "width",
              "base": "mean_bar_range"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "negate"
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 1
  }
}
