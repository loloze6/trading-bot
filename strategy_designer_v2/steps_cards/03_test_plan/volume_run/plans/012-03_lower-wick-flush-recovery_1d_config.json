{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "fall",
        "class": "strategies.strategy_components.VolatilityScaledReturnComponent",
        "params": {
          "period": 1,
          "vol_period": 20,
          "lag": 0
        }
      },
      {
        "id": "vburst",
        "class": "strategies.strategy_components.VolumeRatioComponent",
        "params": {
          "period": 20,
          "exclude_current": 1,
          "statistic": "median",
          "form": "ratio"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "mean_reversion",
        "any_of": [
          [
            {
              "id": "fall",
              "op": "lte",
              "value": -2.0
            },
            {
              "id": "vburst",
              "op": "gte",
              "value": 2.0
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "mean_reversion": {
        "components": [
          {
            "id": "wick",
            "class": "strategies.strategy_components.LowerWickComponent",
            "params": {
              "relative_to": "range"
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    }
  }
}
