{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "nmr",
        "class": "strategies.strategy_components.NetMoveToRangeRatioComponent",
        "params": {
          "period": 30,
          "source": "high_low"
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "nmr",
              "op": "gte",
              "value": 0.5
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
