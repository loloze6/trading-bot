{
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [
      {
        "id": "range_ratio",
        "class": "strategies.strategy_components.MeanBarRangeRatioComponent",
        "params": {
          "long_period": 360,
          "short_period": 28
        }
      },
      {
        "id": "vol_ratio",
        "class": "strategies.strategy_components.VolumeRatioComponent",
        "params": {
          "period": 360,
          "short_period": 28,
          "exclude_current": 0
        }
      }
    ],
    "vetoes": [],
    "rules": [
      {
        "regime": "trending",
        "any_of": [
          [
            {
              "id": "range_ratio",
              "op": "between",
              "low": 0.8,
              "high": 1.25
            },
            {
              "id": "vol_ratio",
              "op": "between",
              "low": 0.8,
              "high": 1.25
            }
          ]
        ]
      }
    ],
    "default_regime": "unknown"
  },
  "strategies": {
    "regimes": {
      "trending": {
        "components": [
          {
            "id": "fall28",
            "class": "strategies.strategy_components.PriceEvolutionOnPeriodComponent",
            "params": {
              "comparison_period": 28
            },
            "weight": 1.0,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 60,
                  "min_periods": 20
                }
              },
              {
                "op": "clip",
                "params": {
                  "max": 0.0
                }
              }
            ]
          }
        ]
      },
      "mean_reversion": null,
      "chop": null,
      "unknown": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 60,
      "target_annual_vol": 0.382099,
      "periods_per_year": 365,
      "max_allocation": 2
    },
    "min_holding_bars": 5
  }
}
