{
  "aux_feeds": [],
  "regime_detector": {
    "mode": "threshold_rules",
    "components": [],
    "rules": [],
    "default_regime": "unknown"
  },
  "strategies": {
    "warmup": 2,
    "regimes": {
      "unknown": {
        "components": [
          {
            "id": "trend_with_short_pullback",
            "class": "strategies.claim_linear.ClaimStrengthComponent",
            "params": {
              "code": "sd = ret.rolling(60, min_periods=60).std().shift(1)\ntrend = df.close.pct_change(60) / (sd * np.sqrt(60))\nstretch = df.close.pct_change(5) / (sd * np.sqrt(5))\nevent = pd.Series(True, index=df.index)\nstrength = (trend.clip(-3, 3) - stretch.clip(-3, 3)).fillna(0)\n",
              "horizon": 10,
              "min_bars": 200
            },
            "weight": 1.0,
            "lookback": 800,
            "transforms": [
              {
                "op": "standardise",
                "params": {
                  "window": 500,
                  "min_periods": 100,
                  "target": 10.0,
                  "cap": 20.0
                }
              }
            ]
          }
        ]
      },
      "trending": null,
      "mean_reversion": null,
      "chop": null
    },
    "sizing": {
      "kind": "vol_target",
      "window": 30,
      "target_annual_vol": 0.2,
      "max_allocation": 1.0,
      "periods_per_year": 365
    }
  }
